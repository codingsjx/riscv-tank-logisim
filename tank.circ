  <circuit name="◆动态预测核心">
    <a name="circuit" val="◆动态预测核心" />
    <appear>
      <rect x="50" y="50" width="340" height="550" fill="#e8f2ff" stroke="#000000" stroke-width="2" />
      <circ-anchor x="387" y="47" width="6" height="6" facing="east" />
      <circ-port pin="180,160" x="46" y="81" width="8" height="8" />
      <text x="60" y="89" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">CLK [1]</text>
      <circ-port pin="180,220" x="46" y="111" width="8" height="8" />
      <text x="60" y="119" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">RST [1]</text>
      <circ-port pin="180,280" x="46" y="141" width="8" height="8" />
      <text x="60" y="149" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">IF.PC [32]</text>
      <circ-port pin="180,340" x="46" y="171" width="8" height="8" />
      <text x="60" y="179" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">IF.IR [32]</text>
      <circ-port pin="180,400" x="46" y="201" width="8" height="8" />
      <text x="60" y="209" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.PC [32]</text>
      <circ-port pin="180,460" x="46" y="231" width="8" height="8" />
      <text x="60" y="239" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.Target [32]</text>
      <circ-port pin="180,520" x="46" y="261" width="8" height="8" />
      <text x="60" y="269" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.PredNextPC [32]</text>
      <circ-port pin="180,580" x="46" y="291" width="8" height="8" />
      <text x="60" y="299" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.Branch [1]</text>
      <circ-port pin="180,640" x="46" y="321" width="8" height="8" />
      <text x="60" y="329" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.JAL [1]</text>
      <circ-port pin="180,700" x="46" y="351" width="8" height="8" />
      <text x="60" y="359" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.JALR [1]</text>
      <circ-port pin="180,760" x="46" y="381" width="8" height="8" />
      <text x="60" y="389" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.Taken [1]</text>
      <circ-port pin="180,820" x="46" y="411" width="8" height="8" />
      <text x="60" y="419" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="start">EX.Fire [1]</text>
      <circ-port pin="3300,160" x="385" y="80" width="10" height="10" />
      <text x="380" y="89" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="end">IF.PredictJump [1]</text>
      <circ-port pin="3300,220" x="385" y="110" width="10" height="10" />
      <text x="380" y="119" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="end">IF.PredNextPC [32]</text>
      <circ-port pin="3300,280" x="385" y="140" width="10" height="10" />
      <text x="380" y="149" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="end">Train [1]</text>
      <circ-port pin="3300,340" x="385" y="170" width="10" height="10" />
      <text x="380" y="179" fill="#000000" font-family="SansSerif" font-size="10" text-anchor="end">EX.Redirect [1]</text>
